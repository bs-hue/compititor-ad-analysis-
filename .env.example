# ==============================================================================
# COMPETITOR INTELLIGENCE & AD SWIPE ENGINE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your keys
# ==============================================================================

# 1. APPLICATION SERVER
PORT=3000

# 2. APIFY AUTOMATED SCRAPING & WINNER DETECTION
APIFY_API_TOKEN=your-apify-api-token-here
APIFY_ACTOR_ID=curious_coder/facebook-ads-library-scraper
APIFY_MAX_ADS_PER_COMPETITOR=15
APIFY_AUTO_SYNC_HOURS=24

# 3. AUDIO-TO-TEXT SPEECH TRANSCRIPTION (SARVAM AI & WHISPER)
# Sarvam AI is recommended for Indian languages & Hinglish (https://www.sarvam.ai/)
SARVAM_API_KEY=your-sarvam-api-key-here

# Optional: OpenAI Whisper for international / English speech transcription
OPENAI_API_KEY=your-openai-api-key-here

